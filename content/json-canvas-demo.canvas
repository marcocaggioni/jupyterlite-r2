{"edges":[{"color":"6","fromNode":"b2c3d4e5f6a7","fromSide":"right","id":"e1a2b3c4d5e6","label":"read the spec","toEnd":"arrow","toNode":"c3d4e5f6a7b8","toSide":"left"},{"fromNode":"c3d4e5f6a7b8","fromSide":"bottom","id":"e2b3c4d5e6f7","label":"see it in a notebook","toEnd":"arrow","toNode":"d4e5f6a7b8c9","toSide":"top"},{"color":"4","fromEnd":"arrow","fromNode":"b2c3d4e5f6a7","fromSide":"right","id":"e3c4d5e6f7a8","label":"two-way","toEnd":"arrow","toNode":"e5f6a7b8c9d0","toSide":"left"},{"color":"#fb464c","fromNode":"e5f6a7b8c9d0","id":"e4d5e6f7a8b9","label":"and so on","toEnd":"arrow","toNode":"f6a7b8c9d0e1"}],"nodes":[{"color":"5","height":420,"id":"a1b2c3d4e5f6","label":"Welcome to JSON Canvas","type":"group","width":640,"x":0,"y":0},{"height":180,"id":"b2c3d4e5f6a7","text":"# Hello, canvas\n\nThis board is a demo of the **JSON Canvas** viewer in JupyterLite.\n\n- text cards render Markdown\n- file cards show a vault path\n- link cards open in a new tab\n- groups hold it together","type":"text","width":280,"x":40,"y":60},{"color":"6","height":90,"id":"c3d4e5f6a7b8","type":"link","url":"https://jsoncanvas.org","width":240,"x":360,"y":60},{"color":"2","file":"python.ipynb","height":90,"id":"d4e5f6a7b8c9","subpath":"#notebook","type":"file","width":240,"x":360,"y":190},{"color":"#e9973f","height":160,"id":"e5f6a7b8c9d0","text":"## Colors\n\nNodes and edges take preset colors `\"1\"`–`\"6\"` or any hex color.\n\nThis card uses a hex orange.","type":"text","width":280,"x":760,"y":80},{"color":"3","height":120,"id":"f6a7b8c9d0e1","text":"Pan by dragging the background. Zoom with the mouse wheel or the buttons. **Fit** frames the whole board.","type":"text","width":280,"x":760,"y":300}]}